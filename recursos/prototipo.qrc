        <file alias="MGLU3.csv">../dados/MGLU3.csv</file>
        <file alias="PETR4.csv">../dados/PETR4.csv</file>
        <file alias="VALE3.csv">../dados/VALE3.csv</file>
    </qresource>
</RCC>
