<RCC version="1.0">
    <!-- Cotacoes de demonstracao do prototipo de telas (lidas por src/prototipo/dadosfixos.cpp).
         INVALIDO-exemplo.csv fica de fora: so serve para a demonstracao da importacao real. -->
